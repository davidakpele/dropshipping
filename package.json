{
  "name": "shopnig",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.5",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.4.0",
    "classnames": "^2.3.2",
    "sass": "^1.83.0",
    "npm-run-all": "^4.1.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^8.1.1",
    "react-router-dom": "^6.11.1",
    "react-scripts": "5.0.1",
    "swiper": "^9.4.1",
    "use-react-router-breadcrumbs": "^4.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "compile": "sass --watch --source-map ./src/assets/scss/main.scss ./src/App.css",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "watch:sass-ui": "sass --watch --source-map ./sass/main.scss ./ui/assets/css/style.css",
    "watch:sass-react": "sass --watch --source-map ./sass/main.scss ./src/App1.css",
    "watch:sass": "npm-run-all --parallel watch:sass-ui watch:sass-react"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "tailwindcss": "^3.3.2"
  }
}
